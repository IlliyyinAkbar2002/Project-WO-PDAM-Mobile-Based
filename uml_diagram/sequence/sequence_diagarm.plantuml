' =====================================================================
' Sequence Diagrams - PDAM Surya Sembada Mobile
' Referensi: https://plantuml.com/sequence-diagram
' =====================================================================


@startuml Login Sequence Diagram
title Sequence Diagram - Login Flow

actor "User" as U
participant "LoginPage\n(UI)" as UI
participant "AuthRemoteDataSource" as DS
participant "AuthStorage\n(flutter_secure_storage)" as Store
participant "Backend API\n(Laravel /v1/auth)" as API

U -> UI : Buka aplikasi
U -> UI : Input email & password
U -> UI : Tap tombol "Masuk"

activate UI
UI -> UI : _formKey.currentState.validate()

alt Form tidak valid
    UI --> U : Tampilkan pesan validasi\n("Email harus diisi" / "Password harus diisi")
else Form valid
    UI -> UI : setState(_isLoading = true)
    UI -> DS : login(email, password)
    activate DS

    DS -> API : POST /v1/auth/login\n{ email, password }
    activate API

    alt Kredensial salah
        API --> DS : 4xx { message, errors }
        DS --> UI : DataFailed(DioException)
        deactivate API
        UI -> UI : _resolveLoginErrorMessage()
        UI --> U : SnackBar error (merah)\n+ _isLoading = false
    else Kredensial valid
        API --> DS : 200 { access_token, user, message }
        deactivate API
        DS --> UI : DataSuccess(AuthResponseModel)
        deactivate DS

        UI -> Store : saveToken(token)
        activate Store
        Store --> UI : ok
        deactivate Store

        UI -> DS : fetchMe()
        activate DS
        DS -> API : GET /v1/auth/me\nAuthorization: Bearer <token>
        activate API
        API --> DS : 200 { id, name, email,\nrole_id, pegawai }
        deactivate API
        DS -> DS : Transform payload\n(pegawai -> employee, position_id)
        DS --> UI : DataSuccess(userData)
        deactivate DS

        UI -> Store : saveUser(userData)
        activate Store
        Store --> UI : ok
        deactivate Store

        UI --> U : SnackBar sukses\n("Login berhasil!")

        alt roleId == 1 (Super Admin)
            UI -> UI : target = admin.LandingPage
        else roleId == 2 (Manajer)
            UI -> UI : target = ManajerLandingPage
        else roleId == 3 && positionId == 4 (SPV)
            UI -> UI : target = SpvLandingPage
        else roleId == 3 (Staff)
            UI -> UI : target = StaffLandingPage
        else fallback
            UI -> UI : target = admin.LandingPage
        end

        UI -> UI : Navigator.pushReplacement(target)
        UI --> U : Halaman utama sesuai role
    end
end
deactivate UI

@enduml


@startuml Registration Sequence Diagram
title Sequence Diagram - Registration Flow (dengan Approval Super Admin)

actor "Calon Pegawai" as U
actor "Super Admin" as SA
participant "RegisterPage\n(UI)" as UI
participant "AuthRemoteDataSource" as DS
participant "AuthStorage" as Store
participant "Backend API\n(Laravel /v1/auth)" as API
participant "Dashboard\nSuper Admin (web)" as ADMIN

U -> UI : Buka halaman daftar
U -> UI : Isi nama, email, password,\ntelepon, jenis_kelamin, tanggal_lahir
U -> UI : Tap tombol "Daftar"

activate UI
UI -> UI : _formKey.currentState.validate()

alt Form tidak valid
    UI --> U : Pesan validasi per-field
else Form valid
    UI -> UI : setState(_isLoading = true)
    UI -> DS : register(name, email, password,\ntelepon, jenisKelamin, tanggalLahir)
    activate DS
    DS -> API : POST /v1/auth/register\n{ ...payload }
    activate API
    API -> API : Buat user (status pending)\n+ pegawai (jabatan_id = null)
    API --> DS : 201 { user, access_token? }
    deactivate API
    DS --> UI : DataSuccess(AuthResponseModel)
    deactivate DS

    note over UI, API
      Setelah register sukses, FE mencoba login
      untuk membaca status approval via /me.
    end note

    UI -> DS : login(email, password)
    activate DS
    DS -> API : POST /v1/auth/login
    activate API
    API --> DS : 200 { access_token, user }
    deactivate API
    DS --> UI : DataSuccess(authResponse)
    deactivate DS

    UI -> Store : saveToken(token) (sementara)
    activate Store
    Store --> UI : ok
    deactivate Store

    UI -> DS : fetchMe()
    activate DS
    DS -> API : GET /v1/auth/me
    activate API
    API --> DS : 200 { ..., pegawai: { jabatan_id } }
    deactivate API
    DS --> UI : DataSuccess(userData)
    deactivate DS

    alt positionId == null (BELUM di-ACC)
        UI -> Store : clearAuth()
        activate Store
        Store --> UI : ok
        deactivate Store
        UI --> U : Dialog "Menunggu Persetujuan"\n("Akun aktif setelah disetujui Super Admin")
        UI -> UI : Navigator.pop() -> kembali ke Login

        == Proses Approval (di luar aplikasi mobile) ==
        SA -> ADMIN : Buka daftar pegawai pending
        SA -> ADMIN : Set jabatan + role_id\n(staff / spv / manajer)
        ADMIN -> API : PUT /v1/users/:id\n(role_id, jabatan_id)
        activate API
        API --> ADMIN : 200 ok
        deactivate API

        == User login ulang setelah di-ACC ==
        U -> UI : (lain waktu) login dengan kredensial yang sama
        ref over UI, API : Lihat Login Sequence Diagram

    else positionId != null (sudah di-ACC saat daftar)
        UI -> Store : saveUser(userData)
        activate Store
        Store --> UI : ok
        deactivate Store
        UI --> U : Dialog sukses "Pendaftaran Berhasil"
        UI -> UI : Pilih landing page sesuai\nroleId & positionId
        UI -> UI : Navigator.pushAndRemoveUntil(target)
        UI --> U : Halaman utama
    end
end
deactivate UI

@enduml


@startuml Assign Staff Sequence Diagram
title Sequence Diagram - SPV Menugaskan Staff ke Work Order

actor "SPV" as SPV
participant "DetailWOPage\n(UI - assign mode)" as UI
participant "WorkOrderRemoteDataSource" as DS
participant "WorkOrderBloc" as Bloc
participant "Backend API\n(Laravel /v1/workorder)" as API

SPV -> UI : Buka detail WO\n(status = ditugaskanKeSpv / 12)
activate UI
UI -> UI : Hitung canAssignStaff\n(isDetailMode && !isManager\n&& !isAssignee && status==12)

alt canAssignStaff == false
    UI --> SPV : Mode read-only (tanpa tombol assign)
else canAssignStaff == true
    UI --> SPV : Render form assign\n(assignees, PIC, kategori_form,\ntanggal, lokasi)

    SPV -> UI : Pilih daftar petugas
    SPV -> UI : Pilih koordinator (PIC)
    SPV -> UI : Isi kategori form\n(meter / jaringan / infrastruktur)
    SPV -> UI : Atur tanggal mulai & estimasi selesai
    SPV -> UI : Tap submit

    UI -> UI : _validateAndAssignStaff()

    alt _isSubmitting || workOrderId == null
        UI --> SPV : (abaikan klik)
    else staffIds kosong
        UI --> SPV : Error "Minimal 1 petugas\nharus dipilih"
    else picId tidak ada di staffIds
        UI --> SPV : Error "Koordinator (PIC) harus\ndipilih dari anggota tim"
    else kategori invalid (field wajib kosong / non-numerik)
        UI --> SPV : Error per-field\n(misal "Jenis pipa wajib diisi")
    else tanggal mulai/selesai kosong
        UI --> SPV : Error "Waktu mulai / Estimasi\nselesai harus diisi"
    else Semua valid
        UI -> UI : Reorder staffIds (PIC index 0)
        UI -> UI : Build petugas[]\n(index 0 -> "koordinator",\nlainnya -> "anggota")
        UI -> UI : setState(_isSubmitting = true)

        UI -> DS : assignStaff(workOrderId, requestBody)
        activate DS
        DS -> API : POST /v1/workorder/:id/assign-staff\n{ kategori_form, form_kategori,\n  petugas, deskripsi?, lokasi?,\n  tanggal_mulai, estimasi_selesai }
        activate API
        API -> API : Validasi payload + otorisasi SPV
        alt Tidak valid
            API --> DS : 4xx { message, errors }
            DS --> UI : DataFailed(DioException)
            deactivate API
        else Valid
            API -> API : Update workorder\n(status, assignees, kategori_form)
            API --> DS : 200 { data: workorder }
            deactivate API
            DS -> DS : Parse WorkOrderModel.fromMap()
            DS --> UI : DataSuccess(updatedWorkOrder?)
        end
        deactivate DS

        UI -> UI : setState(_isSubmitting = false)

        alt DataFailed
            UI --> SPV : SnackBar error
        else DataSuccess
            UI --> SPV : SnackBar "Assign staff berhasil"
            alt updatedWorkOrder != null
                UI -> Bloc : SetWorkOrderDetailEvent(updatedWorkOrder)
            else updatedWorkOrder == null
                UI -> Bloc : GetWorkOrderDetailEvent(workOrderId)
                activate Bloc
                Bloc -> DS : getDetail(workOrderId)
                activate DS
                DS -> API : GET /v1/workorder/:id
                activate API
                API --> DS : 200 { data }
                deactivate API
                DS --> Bloc : DataSuccess(detail)
                deactivate DS
                Bloc --> UI : emit WorkOrderDetailLoaded
                deactivate Bloc
            end
            UI -> Bloc : GetProgressByWorkOrderIdEvent(workOrderId)
            UI --> SPV : Refresh tampilan\n(status -> "Sedang Dikerjakan")
        end
    end
end
deactivate UI

@enduml


@startuml Staff Execute Work Order Sequence Diagram
title Sequence Diagram - Staff Mengerjakan Work Order (tanpa peminjaman material)

actor "Staff (Assignee)" as ST
participant "AssigneeDetailPage\n(UI)" as DET
participant "WorkOrderReportPage\n(UI - mode Mulai/Progress/Selesai)" as REP
participant "Geolocator" as GEO
participant "WorkOrderProgressBloc /\nWorkOrderBloc" as Bloc
participant "WorkOrderProgressRemoteDataSource" as DS
participant "Backend API\n(Laravel /v1/progress-workorder)" as API

ST -> DET : Buka daftar WO -> pilih WO
activate DET
DET -> DET : initState() -> _fetchProgresses()
DET -> DS : getProgressByWorkOrderId(id)
activate DS
DS -> API : GET /v1/progress-workorder?workorder_id=:id
activate API
API --> DS : 200 [ { tipe, dokumentasi_progress, ... } ]
deactivate API
DS --> DET : DataSuccess(progressList)
deactivate DS

DET -> DET : Hitung hasMulai, hasSelesai,\nsisaKuota = 8 - submittedToday

alt !hasMulai
    DET --> ST : Tampilkan tombol\n"Mulai" (+ "Pinjam Material" - di luar scope)
else hasSelesai
    DET --> ST : Mode read-only (riwayat laporan)
else
    DET --> ST : List progress + tombol\n"Laporan" / "Selesai"
    alt sisaKuota == 0
        DET --> ST : Disable tombol "Laporan"\n(kuota harian habis)
    end
end

== Tahap 1: Mulai Pekerjaan (tipeProgressId = 1) ==

ST -> DET : Tap "Mulai"
DET -> REP : Buka WorkOrderReportPage(mode = Mulai)
activate REP

REP -> GEO : _checkDistance()\n(serviceEnabled + permission)
activate GEO
GEO --> REP : currentPosition / error
deactivate GEO

alt GPS off / izin ditolak
    REP --> ST : Error "Aktifkan GPS / izin lokasi"
else jarak > radiusMeter
    REP -> REP : _inRange = false
    REP --> ST : Error "Anda di luar jangkauan lokasi"
else jarak <= radiusMeter
    REP -> REP : _inRange = true
    REP --> ST : SnackBar "Dalam jangkauan"

    ST -> REP : Isi deskripsi & foto (opsional)
    ST -> REP : Tap Submit
    REP -> REP : _onSubmit()
    alt deskripsi kosong
        REP --> ST : Error "Deskripsi tidak boleh kosong"
    else
        REP -> GEO : getCurrentPosition()
        activate GEO
        GEO --> REP : _currentPosition
        deactivate GEO
        REP -> REP : Build WorkOrderProgressModel\n{ tipeProgressId=1, description,\nphotos, koordinat }
        REP -> Bloc : UpdateWorkOrderProgressEvent(model)
        activate Bloc
        Bloc -> DS : startProgress(model)
        activate DS
        DS -> API : POST /v1/progress-workorder/start\n(multipart)
        activate API
        API -> API : Simpan progress\n+ update status WO -> "Sedang Dikerjakan"
        API --> DS : 200 { progress, workorder }
        deactivate API
        DS --> Bloc : DataSuccess
        deactivate DS
        Bloc --> REP : emit WorkOrderProgressUpdated
        deactivate Bloc
        REP --> ST : SnackBar "Form berhasil disubmit"
        REP -> DET : Navigator.pop(shouldRefresh = true)
        deactivate REP
        DET -> DET : _fetchProgresses()
    end
end

== Tahap 2: Laporan Berkala (tipeProgressId = 2, dapat berulang) ==

loop selama belum selesai & sisaKuota > 0
    ST -> DET : Tap "Laporan"
    DET -> REP : Buka WorkOrderReportPage(mode = Progress)
    activate REP
    REP --> ST : Form dinamis (progressDetails)

    ST -> REP : Isi deskripsi, field dinamis, foto (min. 1)
    ST -> REP : Tap Submit
    REP -> REP : _onSubmit() + validasi\n(deskripsi, foto, field wajib)

    alt validasi gagal
        REP --> ST : Error spesifik
    else valid
        REP -> GEO : getCurrentPosition()
        activate GEO
        GEO --> REP : _currentPosition
        deactivate GEO
        REP -> REP : Build WorkOrderProgressModel\n{ tipeProgressId=2, ... }
        REP -> Bloc : UpdateWorkOrderProgressEvent(model)
        activate Bloc
        Bloc -> DS : submitProgress(model)
        activate DS
        DS -> API : POST /v1/progress-workorder/submit\n(multipart + detail value/image)
        activate API
        API --> DS : 200 { progress }
        deactivate API
        DS --> Bloc : DataSuccess
        deactivate DS
        Bloc --> REP : emit WorkOrderProgressUpdated
        deactivate Bloc
        REP --> ST : SnackBar sukses
        REP -> DET : pop(shouldRefresh = true)
        deactivate REP
        DET -> DET : _fetchProgresses() -> update sisaKuota
    end

    opt Staff membatalkan laporan (< 5 menit)
        ST -> DET : Tap "Batalkan" pada ProgressCard
        DET -> DET : _confirmCancel() -> Dialog
        ST -> DET : Konfirmasi "Ya"
        DET -> DS : cancelProgress(progressId)
        activate DS
        DS -> API : POST /v1/progress-workorder/:id/cancel
        activate API
        alt masih < 5 menit
            API --> DS : 200 ok (kuota dikembalikan\njika bukan tipe Mulai)
        else lewat batas waktu
            API --> DS : 4xx { message }
        end
        deactivate API
        DS --> DET : DataState
        deactivate DS
        DET -> DET : _fetchProgresses() -> reload
    end
end

== Tahap 3: Selesai (tipeProgressId = 3) ==

ST -> DET : Tap "Selesai"
DET -> REP : Buka WorkOrderReportPage(mode = Selesai)
activate REP
REP --> ST : Form penutup
ST -> REP : Isi deskripsi akhir + foto bukti
ST -> REP : Tap Submit
REP -> REP : Validasi (deskripsi & foto wajib)

alt validasi gagal
    REP --> ST : Error
else valid
    REP -> GEO : getCurrentPosition()
    activate GEO
    GEO --> REP : _currentPosition
    deactivate GEO
    REP -> REP : Build WorkOrderProgressModel\n{ tipeProgressId=3, ... }
    REP -> Bloc : UpdateWorkOrderProgressEvent(model)
    activate Bloc
    Bloc -> DS : submitProgress(model)
    activate DS
    DS -> API : POST /v1/progress-workorder/submit
    activate API
    API -> API : Simpan progress final\n+ update status WO -> "Selesai"
    API --> DS : 200 { progress, workorder }
    deactivate API
    DS --> Bloc : DataSuccess
    deactivate DS
    Bloc --> REP : emit WorkOrderProgressUpdated
    deactivate Bloc
    REP --> ST : SnackBar "Form berhasil disubmit"
    REP -> DET : pop(shouldRefresh = true)
    deactivate REP
    DET -> DET : _fetchProgresses()
    DET -> DET : hasSelesai = true
    DET --> ST : Sembunyikan tombol aksi\n(mode read-only)
end
deactivate DET

@enduml
