@startuml Activity Diagram Progress WO Jaringan
title Activity Diagram - Eksekusi (Progress) Work Order Jaringan oleh Staff (PDAM Surya Sembada Mobile)

skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF59D
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam DefaultFontName Arial
skinparam swimlaneWidth 260

|Staff|
start
:Membuka aplikasi mobile
dan login sebagai Staff;
:Membuka halaman
"Work Order";

|Aplikasi Mobile|
:List Work Order
yang ditugaskan ke Staff;

|Backend|
:Mengambil daftar Work Order
dengan status
"Ditugaskan ke Staff";
note right
  Work Order Jaringan ini
  sebelumnya telah ditugaskan
  oleh Supervisor (lihat alur
  Penugasan WO Jaringan).

  Pada saat penugasan,
  Supervisor sudah mengisi
  informasi awal seperti:
  - Jenis Pipa
  - Diameter Pipa
  - Panjang Pipa
  - Tingkat Kerusakan
  - Waktu pengerjaan
  - Lokasi
  - Anggota staff & Koordinator

  Contoh pekerjaan pada
  WO Jaringan: perbaikan pipa
  bocor atau penggantian
  jaringan pipa distribusi.
end note
:Mengirim daftar Work Order
ke aplikasi;

|Aplikasi Mobile|
:Menampilkan daftar Work Order
pada halaman "Work Order";

|Staff|
:Memilih Work Order Jaringan
yang akan dikerjakan;

|Aplikasi Mobile|
:Menampilkan halaman detail
Work Order beserta tombol
pelaporan ("Mulai");

' ====================================================================
' TAHAP 1 - MEMULAI PEKERJAAN
' ====================================================================
|Staff|
:Menekan tombol "Mulai";

|Aplikasi Mobile|
:Menampilkan formulir Jurnal Mulai
(deskripsi pekerjaan dan
foto dokumentasi);

|Staff|
:Mengisi deskripsi pekerjaan
dan foto dokumentasi;
:Menekan tombol "Mulai";

|Aplikasi Mobile|
:Memeriksa lokasi Staff
melalui GPS;
if (Staff berada dalam radius lokasi pekerjaan?) then (tidak)
  :Menampilkan pesan
  "Lokasi Anda di luar jangkauan";
  stop
else (ya)
  :Mengirim data Mulai
  (deskripsi, foto, koordinat GPS)
  ke server;
endif

|Backend|
:Menyimpan laporan "Mulai"
dan mengubah status Work Order
menjadi "Dalam Pengerjaan";
:Mengirim konfirmasi
berhasil;

|Aplikasi Mobile|
:Menampilkan pesan
"Form berhasil disubmit";
:Menampilkan tombol
"Laporan" dan "Selesai";

' ====================================================================
' TAHAP 2 - LAPORAN PROGRES HARIAN (DAPAT BERULANG, OPSIONAL)
' ====================================================================
|Staff|
note right
  Tahap "Laporan" bersifat
  pilihan dan dapat dilakukan
  berkali-kali selama proses
  pengerjaan berlangsung
  (mis. melaporkan kemajuan
  perbaikan pipa setiap hari).

  Jumlah laporan per hari
  dibatasi oleh kuota harian.
end note
:Menekan tombol "Laporan"
untuk melaporkan kemajuan
pekerjaan (opsional);

|Aplikasi Mobile|
if (Kuota laporan hari ini masih tersedia?) then (tidak)
  :Menonaktifkan tombol "Laporan"
  dan menampilkan "Kuota Anda Habis";
else (ya)
  :Mengisi formulir Jurnal
  (deskripsi dan foto),
  lalu memeriksa GPS;
  :Mengirim laporan progres
  ke server;

  |Backend|
  :Menyimpan laporan progres
  dan mengurangi kuota harian;
  :Mengirim konfirmasi berhasil;

  |Aplikasi Mobile|
  :Menampilkan laporan progres
  pada daftar riwayat;
endif

' ====================================================================
' TAHAP 3 - MENYELESAIKAN PEKERJAAN
' ====================================================================
|Staff|
:Menekan tombol "Selesai";

|Aplikasi Mobile|
:Menampilkan formulir Jurnal Selesai
beserta form khusus Jaringan
(Tindakan Perbaikan dan
Hasil Inspeksi);

|Staff|
:Mengisi deskripsi, foto,
Tindakan Perbaikan,
dan Hasil Inspeksi;
note right
  Contoh pengisian akhir:
  - Tindakan Perbaikan : Mengganti
    pipa bocor sepanjang 6 meter
    dan memasang klem baru
  - Hasil Inspeksi     : Sambungan
    tidak bocor, tekanan air
    kembali normal
end note
:Menekan tombol "Selesai";

|Aplikasi Mobile|
:Memeriksa kelengkapan formulir
dan lokasi GPS;
if (Data lengkap dan dalam jangkauan?) then (belum)
  :Menampilkan pesan kesalahan
  (mis. "Tindakan Perbaikan wajib diisi",
   "Hasil Inspeksi wajib diisi",
   "Minimal satu foto diperlukan");
  stop
else (sudah)
  :Mengirim laporan "Selesai"
  ke server;
endif

|Backend|
:Menyimpan laporan "Selesai"
dan mengubah status Work Order
menjadi "Pengecekan"
(menunggu pemeriksaan Supervisor);
:Mengirim konfirmasi berhasil;

|Aplikasi Mobile|
:Menampilkan pesan
"Form berhasil disubmit";

|Staff|
:Melihat Work Order Jaringan
berpindah ke status
"Pengecekan"
(menunggu pemeriksaan Supervisor);
note right
  Proses pemeriksaan / persetujuan
  laporan oleh Supervisor dibahas
  pada alur terpisah (di luar
  cakupan diagram ini).
end note
stop

@enduml
