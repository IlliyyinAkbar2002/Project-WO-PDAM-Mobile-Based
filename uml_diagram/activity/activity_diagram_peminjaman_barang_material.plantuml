@startuml Activity Diagram Peminjaman Barang Material
title Activity Diagram - Peminjaman Barang Material untuk Work Order oleh Staff (PDAM Surya Sembada Mobile)

skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF59D
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam DefaultFontName Arial
skinparam swimlaneWidth 260

|Staff|
start
:Membuka aplikasi mobile
dan login sebagai Staff;
:Membuka detail Work Order
yang sedang dikerjakan;
note right
  Sebelum mulai mengerjakan
  Work Order, Staff (atau
  Koordinator tim) meminjam
  barang material yang
  dibutuhkan untuk pekerjaan.

  Peminjaman material diajukan
  dari dalam halaman Detail
  Work Order, sehingga material
  selalu terhubung dengan
  Work Order terkait.
end note
:Menekan tombol
"Pinjam Material";

|Aplikasi Mobile|
:Meminta daftar stok
barang material dari server;

|Backend|
:Mengambil daftar material
beserta jumlah stok
yang tersedia;
:Mengirim daftar material
ke aplikasi;

|Aplikasi Mobile|
:Menampilkan halaman
"Inventory Material"
(daftar stok material);

|Staff|
:Mencari dan memilih
barang material yang
dibutuhkan;
note right
  Material dapat dicari
  berdasarkan nama atau
  ditapis menurut kategori
  (mis. Perpipaan, Fitting,
  Sambungan Rumah).
end note
:Menekan tombol
"Request to Borrow"
pada material yang dipilih;

|Aplikasi Mobile|
:Menampilkan formulir
"Borrow Material"
(jumlah pinjam dan
catatan peminjaman);

|Staff|
:Mengisi jumlah barang
yang akan dipinjam dan
catatan (opsional);
note right
  Contoh pengisian:
  - Material      : Pipa PVC 4 inch
  - Jumlah Pinjam : 10 batang
  - Catatan       : Untuk perbaikan
    pipa bocor di Jl. Mawar
end note
:Menekan tombol
"Ajukan Peminjaman";

|Aplikasi Mobile|
:Memeriksa kelengkapan
jumlah peminjaman;
if (Jumlah valid dan stok mencukupi?) then (tidak)
  :Menampilkan pesan kesalahan
  (mis. "Jumlah pinjam wajib diisi",
   "Stok tidak mencukupi");
  stop
else (ya)
  :Mengirim data peminjaman
  (material, jumlah, catatan)
  ke server;
endif

|Backend|
:Menyimpan data peminjaman
dan mengaitkannya dengan
Work Order terkait;
if (Peminjaman berhasil disimpan?) then (tidak)
  :Mengirim pesan kesalahan;

  |Aplikasi Mobile|
  :Menampilkan pesan
  "Gagal mengajukan peminjaman";
  stop
else (ya)
  :Mengurangi jumlah stok
  material yang tersedia;
  :Menandai status peminjaman
  menjadi "Dipinjam";
  :Mengirim konfirmasi
  peminjaman berhasil;
endif

|Aplikasi Mobile|
:Menampilkan pesan
"Peminjaman Berhasil"
beserta keterangan stok
telah dikurangi;

|Staff|
:Melihat barang material
muncul pada daftar
"Peminjaman Saya"
dengan status "Dipinjam";
note right
  Material yang dipinjam siap
  digunakan untuk eksekusi
  Work Order. Proses pengembalian
  material dibahas pada alur
  terpisah (di luar cakupan
  diagram ini).
end note
stop

@enduml
