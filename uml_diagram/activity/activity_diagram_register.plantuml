@startuml Activity Diagram Registrasi
title Activity Diagram - Proses Registrasi Karyawan (PDAM Surya Sembada Mobile)

skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF59D
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam DefaultFontName Arial

|User|
start
:Membuka halaman Registrasi
dari halaman Login;
:Mengisi data diri
(Nama Lengkap, Email, Password,
Nomor Telepon, Jenis Kelamin,
Tanggal Lahir);
:Menekan tombol "Daftar";

|Aplikasi Mobile|
:Memeriksa kelengkapan
dan format data
(email, panjang password,
nomor telepon);
if (Semua data sudah benar?) then (belum)
  :Menampilkan pesan kesalahan
  pada kolom yang bermasalah;
  stop
else (sudah)
  :Menampilkan indikator loading;
  :Mengirim data pendaftaran
  ke server;
endif

|Backend|
:Menerima data pendaftaran;
:Memeriksa apakah email
sudah pernah didaftarkan;
if (Pendaftaran berhasil?) then (tidak)
  :Mengirim pesan kesalahan
  (mis. "Email sudah terdaftar");

  |Aplikasi Mobile|
  :Menampilkan dialog
  "Pendaftaran Gagal";
  stop
else (ya)
  :Menyimpan akun baru
  dengan status
  "menunggu persetujuan";
  :Mengirim konfirmasi
  pendaftaran berhasil;
endif

note right
  **Proses Persetujuan oleh Super Admin**
  (dilakukan melalui aplikasi web,
  di luar aplikasi mobile)

  Super Admin meninjau data karyawan,
  lalu menyetujui akun dengan memberikan
  jabatan (Supervisor atau Staff).
end note

|Aplikasi Mobile|
:Memeriksa status persetujuan
akun ke server;

|Backend|
if (Akun sudah disetujui
Super Admin?) then (belum)
  :Mengirim status
  "menunggu persetujuan";

  |Aplikasi Mobile|
  :Menampilkan dialog
  "Menunggu Persetujuan
  dari Super Admin";
  :Mengarahkan kembali
  ke halaman Login;
  stop
else (sudah)
  :Mengirim data profil
  beserta jabatan
  (Supervisor / Staff);
endif

|Aplikasi Mobile|
:Menyimpan data pengguna
di perangkat;
:Menampilkan dialog
"Pendaftaran Berhasil";
:Memeriksa jabatan pengguna;

if (Jabatan?) then (Supervisor)
  :Membuka halaman utama
  Supervisor;
else (Staff)
  :Membuka halaman utama
  Staff;
endif

|User|
:Melihat halaman utama
sesuai jabatannya;
stop

@enduml
