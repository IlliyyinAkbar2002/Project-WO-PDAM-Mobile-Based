@startuml Activity Diagram Lupa Password
title Activity Diagram - Proses Lupa Password (PDAM Surya Sembada Mobile)

skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF59D
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam DefaultFontName Arial
skinparam swimlaneWidth 260

|User|
start
:Membuka aplikasi mobile
dan masuk ke halaman Login;
:Menekan tautan
"Lupa Password?";

|Aplikasi Mobile|
:Menampilkan halaman
"Lupa Password"
(kolom email);

|User|
:Memasukkan email
yang terdaftar;
:Menekan tombol "Lanjutkan";

|Aplikasi Mobile|
:Memeriksa kelengkapan
dan format email;
if (Email sudah diisi dan formatnya benar?) then (belum)
  :Menampilkan pesan kesalahan
  ("Email harus diisi" /
  "Format email tidak valid");
  stop
else (sudah)
  :Mengirim email ke server
  untuk diperiksa;
endif

|Backend|
:Mencari email pengguna
di basis data;
note right
  Pada tahap ini sistem hanya memastikan
  email benar-benar terdaftar. Belum ada
  perubahan password yang dilakukan.
end note
if (Email terdaftar?) then (tidak)
  :Mengirim pesan
  "Email tidak terdaftar";

  |Aplikasi Mobile|
  :Menampilkan pesan
  "Email Tidak Ditemukan";
  stop
else (ya)
  :Mengirim konfirmasi
  bahwa email terdaftar;
endif

|Aplikasi Mobile|
:Menampilkan pesan
"Email Terdaftar";

|User|
:Menekan tombol
"Atur Password";

|Aplikasi Mobile|
:Menampilkan halaman
"Atur Password Baru";

|User|
:Memasukkan password baru;
:Memasukkan ulang password baru
sebagai konfirmasi;
:Menekan tombol "Simpan Password";

|Aplikasi Mobile|
:Memeriksa password baru
dan konfirmasinya;
if (Password valid dan konfirmasi sama?) then (belum)
  :Menampilkan pesan kesalahan
  ("Password minimal 8 karakter" /
  "Konfirmasi password tidak sama");
  stop
else (sudah)
  :Mengirim email dan
  password baru ke server;
endif

|Backend|
:Menyimpan password baru
untuk email tersebut;
if (Password berhasil disimpan?) then (tidak)
  :Mengirim pesan kesalahan;

  |Aplikasi Mobile|
  :Menampilkan pesan
  "Gagal Mengatur Password";
  stop
else (ya)
  :Mengirim konfirmasi
  "Password berhasil diatur ulang";
endif

|Aplikasi Mobile|
:Menampilkan pesan
"Password Berhasil Diatur";

|User|
:Menekan tombol
"Kembali ke Login";
:Login menggunakan
password baru;
stop

@enduml
