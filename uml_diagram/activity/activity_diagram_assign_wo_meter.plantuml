@startuml Activity Diagram Penugasan WO Meter
title Activity Diagram - Penugasan Work Order Meter oleh Supervisor (PDAM Surya Sembada Mobile)

skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF59D
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam DefaultFontName Arial

|Supervisor|
start
:Membuka aplikasi mobile
dan login sebagai Supervisor;
:Membuka halaman
"Work Order Masuk";

|Aplikasi Mobile|
:Meminta daftar Work Order
yang ditujukan ke Supervisor
dari server;

|Backend|
:Mengambil daftar Work Order
yang sudah dibuat Super Admin
dengan status
"Ditugaskan ke Supervisor";
note right
  Work Order Meter
  sebelumnya telah dibuat
  oleh Super Admin melalui
  aplikasi web (proses
  pembuatan tidak dirinci
  dalam alur ini).

  Pada saat pembuatan,
  Super Admin sudah mengisi
  informasi awal seperti:
  - Nama pekerjaan
  - Deskripsi
  - Tanggal mulai
  - Lokasi
  - Prioritas
  - Supervisor yang dituju

  Contoh objek yang dikelola
  pada WO Meter: meter air
  pelanggan yang rusak,
  meter baru yang akan
  dipasang, atau penggantian
  meter pelanggan.
end note
:Mengirim daftar Work Order
ke aplikasi;

|Aplikasi Mobile|
:Menampilkan daftar Work Order
pada halaman "Work Order Masuk";

|Supervisor|
:Memilih salah satu Work Order
Meter yang akan ditugaskan;

|Aplikasi Mobile|
:Meminta detail Work Order
dari server;

|Backend|
:Mengirim detail Work Order
beserta informasi awal
yang dibuat Super Admin;

|Aplikasi Mobile|
:Menampilkan formulir
detail Work Order Meter
(judul, deskripsi, lokasi,
tanggal mulai);

|Supervisor|
:Melengkapi informasi meter
(nomor meter dan
kondisi meter awal);
note right
  Contoh pengisian:
  - Nomor Meter        : MTR-2026-00451
  - Kondisi Meter Awal : Kaca meter pecah,
    angka stand tidak terbaca,
    diduga bocor pada sambungan
end note
:Mengatur waktu pengerjaan
(tanggal mulai dan estimasi
waktu selesai);
:Memilih lokasi pekerjaan
di peta jika perlu;
:Memilih anggota staff
yang akan ditugaskan;
:Menentukan satu staff
sebagai Koordinator (PIC);
:Menekan tombol "Tugaskan";

|Aplikasi Mobile|
:Memeriksa kelengkapan
data formulir;
if (Data sudah lengkap dan benar?) then (belum)
  :Menampilkan pesan kesalahan
  pada bagian yang masih
  belum lengkap
  (mis. "Nomor meter wajib diisi",
   "Kondisi meter awal wajib diisi");
  stop
else (sudah)
  :Mengirim data penugasan
  ke server;
endif

|Backend|
:Menyimpan data penugasan
(staff terpilih, koordinator,
detail meter, waktu, lokasi);
if (Penugasan berhasil disimpan?) then (tidak)
  :Mengirim pesan kesalahan;

  |Aplikasi Mobile|
  :Menampilkan pesan
  "Gagal menugaskan staff";
  stop
else (ya)
  :Mengubah status Work Order
  menjadi "Ditugaskan ke Staff";
  :Mengirim konfirmasi
  penugasan berhasil;
endif

|Aplikasi Mobile|
:Menampilkan pesan
"Penugasan staff berhasil";
:Memperbarui tampilan
detail Work Order
dengan data terbaru;

|Supervisor|
:Melihat Work Order
sudah berpindah ke
daftar "Work Order Keluar"
dengan status
"Ditugaskan ke Staff";
stop

@enduml
