@startuml Activity Diagram Login
title Activity Diagram - Proses Login (PDAM Surya Sembada Mobile)

skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF59D
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam DefaultFontName Arial

|User|
start
:Membuka aplikasi PDAM
dan masuk ke halaman Login;
:Mengisi email dan password;
:Menekan tombol "Masuk";

|Aplikasi Mobile|
:Memeriksa kelengkapan
email dan password;
if (Data sudah lengkap?) then (belum)
  :Menampilkan pesan
  "Email harus diisi" /
  "Password harus diisi";
  stop
else (sudah)
  :Menampilkan indikator loading;
  :Mengirim data login
  ke server;
endif

|Backend|
:Menerima data login;
:Memeriksa email dan password
di basis data;

if (Email dan password benar?) then (tidak)
  :Mengirim pesan kesalahan
  ke aplikasi;

  |Aplikasi Mobile|
  :Menampilkan pesan kesalahan
  (mis. "Email salah",
   "Password salah",
   "Koneksi bermasalah");
  :Menyembunyikan indikator loading;
  stop
else (ya)
  :Mengirim data pengguna
  dan token akses;
endif

|Aplikasi Mobile|
:Menyimpan token
dan data pengguna
di perangkat;

|Backend|
:Mengambil data profil
pengguna lengkap;
:Mengirim data profil
(nama, jabatan, peran);

|Aplikasi Mobile|
:Menyimpan data profil
pengguna;
:Menampilkan pesan
"Login berhasil";
:Memeriksa peran pengguna;

if (Peran pengguna?) then (Supervisor)
  :Membuka halaman utama Supervisor;
else (Staff)
  :Membuka halaman utama Staff;
endif

|User|
:Melihat halaman utama
sesuai perannya;
stop

@enduml



