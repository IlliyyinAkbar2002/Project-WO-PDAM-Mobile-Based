                <mxCell id="note_preview_same" value="Pratinjau ini dibangun dari data &amp; susunan yang sama dengan berkas PDF yang akan diekspor, sehingga tampilan pratinjau sudah mencerminkan hasil akhir PDF-nya." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="1840" y="310" width="340" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="note_multipage" value="Daftar anggota tim disusun dalam bentuk tabel agar barisnya otomatis bersambung rapi ke halaman berikutnya tanpa terpotong saat anggota tim berjumlah banyak — memenuhi kebutuhan format multi-halaman." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="1840" y="1230" width="340" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="note_doku_gap" value="Catatan: bagian &quot;dokumentasi&quot; pada berkas PDF saat ini berupa ringkasan teks hasil pekerjaan; belum menyertakan lampiran foto dokumentasi secara langsung di dalam berkas." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
