                <mxCell id="u_open" value="Membuka menu &quot;Work Order&quot;, lalu memilih tab riwayat&lt;br&gt;(&quot;Riwayat&quot; bagi Staff/Staff Senior, &quot;History Work Order&quot; bagi SPV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
