                <mxCell id="s_criteria" value="Menentukan kriteria riwayat default sesuai peran pengguna:&lt;br&gt;• Staff/Staff Senior → status Selesai, Menunggu Approval Manager, Ditolak Manager&lt;br&gt;• SPV → status Selesai, dibatasi pada Work Order yang di-PIC-kan kepadanya" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="520" y="200" width="620" height="160" as="geometry"/>
                </mxCell>

                <mxCell id="note_role" value="Catatan hak akses (AC1):&lt;br&gt;Data yang tampil otomatis dibatasi sesuai identitas dan peran pengguna yang sedang login (Staff/Staff Senior hanya melihat WO miliknya sendiri; SPV hanya WO yang di-PIC-kan kepadanya). Filter tanggal/status di bawah hanya mempersempit hasil ini, bukan mengganti batasan hak akses." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
