<mxfile host="65bd71144e">
    <diagram id="PBI34_log_penggunaan_material" name="PBI34: Log Penggunaan Material (Employee - SPV)">
        <mxGraphModel dx="1578" dy="1168" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>

                <mxCell id="title" value="Activity Diagram - PBI34: Log Penggunaan Material (PDAM Surya Sembada Mobile)&lt;br&gt;&lt;span style=&quot;font-weight:normal;font-size:12px;&quot;&gt;Berlaku untuk Employee dengan jabatan SPV (Supervisor)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontFamily=Arial;" parent="1" vertex="1">
                    <mxGeometry width="2060" height="70" as="geometry"/>
                </mxCell>

                <mxCell id="lane1" value="User" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;startSize=40;fillColor=#FAFAFA;strokeColor=#90A4AE;fontFamily=Arial;fontStyle=1;fontSize=14;verticalAlign=middle;swimlaneFillColor=default;" parent="1" vertex="1">
                    <mxGeometry y="80" width="480" height="2700" as="geometry"/>
                </mxCell>
                <mxCell id="lane2" value="Sistem" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;startSize=40;fillColor=#FAFAFA;strokeColor=#90A4AE;fontFamily=Arial;fontStyle=1;fontSize=14;verticalAlign=middle;swimlaneFillColor=default;" parent="1" vertex="1">
                    <mxGeometry x="480" y="80" width="700" height="2700" as="geometry"/>
                </mxCell>
                <mxCell id="lane3" value="Backend" style="swimlane;horizontal=1;whiteSpace=wrap;html=1;startSize=40;fillColor=#FAFAFA;strokeColor=#90A4AE;fontFamily=Arial;fontStyle=1;fontSize=14;verticalAlign=middle;swimlaneFillColor=default;" parent="1" vertex="1">
                    <mxGeometry x="1180" y="80" width="500" height="2700" as="geometry"/>
                </mxCell>

                <mxCell id="noteA" value="Catatan cakupan aktor (AC3): Acceptance criteria PBI34 mencakup seluruh aktor (Superadmin, Admin, Manajer, Employee). Superadmin/Admin/Manajer memantau log ini lewat aplikasi Back-Office (di luar scope mobile). Diagram ini hanya mencakup aktor Employee berjabatan SPV pada aplikasi mobile — data yang tampil otomatis dibatasi hanya pada Work Order yang berada di bawah tanggung jawab SPV yang login, bukan seluruh Work Order di sistem." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="0" y="130" width="2060" height="120" as="geometry"/>
                </mxCell>

                <mxCell id="noteB" value="Catatan pencatatan otomatis (AC1 &amp; AC2): Log ini tidak memiliki input manual tersendiri. Setiap kali Staff mengajukan peminjaman material (otomatis disetujui) atau mengajukan pengembalian material yang kemudian diverifikasi SPV — proses pada fitur lain — Backend otomatis menyimpan satu entri berisi jenis material, jumlah, dan waktu penggunaan untuk Work Order terkait. Alur di samping hanya mencakup proses membaca/menampilkan log tersebut." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="1720" y="930" width="340" height="260" as="geometry"/>
                </mxCell>

                <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="225" y="280" width="30" height="30" as="geometry"/>
                </mxCell>

                <mxCell id="u_open" value="Membuka menu &quot;Log Penggunaan Material&quot; pada halaman utama" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="60" y="350" width="380" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="s_scope" value="Menyiapkan permintaan riwayat log, dibatasi otomatis hanya pada Work Order yang menjadi tanggung jawab SPV yang sedang login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="520" y="350" width="620" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="s_send" value="Mengirim permintaan data log penggunaan material ke Backend&lt;br&gt;(GET /v1/workorder, lalu GET /v1/workorder/{id}/peminjaman-material tiap Work Order)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="520" y="500" width="620" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="be_receive" value="Menerima permintaan data log penggunaan material" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="660" width="420" height="90" as="geometry"/>
                </mxCell>

                <mxCell id="be_dec" value="Permintaan valid dan terautentikasi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;fontFamily=Arial;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="800" width="300" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="be_err" value="Mengembalikan respons gagal&lt;br&gt;(401/403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontFamily=Arial;fontSize=11;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="960" width="190" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="be_query" value="Mengambil seluruh catatan peminjaman &amp; pengembalian material pada Work Order milik SPV terkait — data yang sudah tercatat otomatis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=11;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="1440" y="960" width="200" height="150" as="geometry"/>
                </mxCell>

                <mxCell id="be_return" value="Menyusun &amp; mengembalikan daftar log — jenis material, jumlah, waktu penggunaan, status, dan Work Order terkait tiap entri&lt;br&gt;(atau daftar kosong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=11;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="1160" width="420" height="140" as="geometry"/>
                </mxCell>

                <mxCell id="s_dec" value="Permintaan berhasil?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;fontFamily=Arial;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="680" y="1350" width="300" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="s_err" value="Menampilkan pesan gagal beserta tombol &quot;Coba Lagi&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontFamily=Arial;fontSize=11;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="540" y="1500" width="270" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="s_show" value="Menampilkan daftar log penggunaan material, diurutkan dari yang terbaru (atau &quot;Belum ada data&quot; bila kosong); tiap entri memuat jenis material, jumlah, waktu penggunaan, status, dan Work Order terkait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=11;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="850" y="1500" width="290" height="170" as="geometry"/>
                </mxCell>

                <mxCell id="u_lihat" value="Melihat daftar log penggunaan material — tiap entri menampilkan jenis material, jumlah, waktu penggunaan, dan Work Order terkait" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1720" width="380" height="140" as="geometry"/>
                </mxCell>

                <mxCell id="u_dec" value="Ingin mencari atau menyaring log tertentu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF59D;strokeColor=#F9A825;fontFamily=Arial;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1900" width="300" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="u_filter" value="Memasukkan kata kunci pencarian, dan/atau memilih Work Order, rentang tanggal, atau status pada dialog filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
                    <mxGeometry x="60" y="2050" width="380" height="140" as="geometry"/>
                </mxCell>

                <mxCell id="s_refilter" value="Menyusun ulang kriteria (kata kunci/Work Order/tanggal/status) sesuai pilihan pengguna, lalu mengirim permintaan baru ke Backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontFamily=Arial;fontSize=12;arcSize=20;" parent="1" vertex="1">
