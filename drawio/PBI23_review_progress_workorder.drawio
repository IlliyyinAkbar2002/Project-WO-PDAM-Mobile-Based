                <mxCell id="note_valid_fe2" value="Syarat data valid:&lt;br&gt;- Deskripsi pekerjaan tidak boleh kosong&lt;br&gt;- Dokumentasi (foto) minimal 1, maksimal 2MB per foto&lt;br&gt;- Field hasil akhir wajib sesuai jenis WO&lt;br&gt;- Waktu submit sampai pukul 16:00, kecuali prioritas Urgent&lt;br&gt;- Lokasi GPS berada dalam radius lokasi WO" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
