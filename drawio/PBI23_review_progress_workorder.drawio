                <mxCell id="note_pre" value="Precondition:&lt;br&gt;PIC (Staff Senior) telah menyelesaikan seluruh tahapan pekerjaan (Persiapan→Pengerjaan→Pengujian; ref. PBI24) dan mengirim laporan akhir. Work Order berstatus &quot;Proses&quot;, menunggu review SPV." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="1980" y="120" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="note_disk" value="Catatan istilah:&lt;br&gt;Acceptance Criteria menyebut &quot;PIC&quot; sebagai peninjau. Implementasi (gerbang 403 pada endpoint review) memastikan yang berwenang meninjau &amp; memutuskan adalah SPV yang ditugaskan pada Work Order ini (workorder.assigned_to), bukan PIC — PIC adalah koordinator tim yang menyusun &amp; mengirim laporan.&lt;br&gt;&lt;br&gt;Catatan juga: hanya 2 keputusan yang benar-benar tersedia — &quot;Terima&quot; dan &quot;Revisi&quot;. Tidak ada opsi &quot;Tolak&quot; permanen pada versi saat ini." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="1980" y="310" width="320" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="note_valid" value="Validasi Backend (berlaku utk kedua keputusan):&lt;br&gt;- SPV harus tercatat sebagai penanggung jawab (assigned_to) WO ini → 403 jika bukan&lt;br&gt;- Work Order belum berstatus final (Selesai/Tutup) → 422 jika sudah" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="1980" y="600" width="320" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="note_nonotif" value="Catatan:&lt;br&gt;Berbeda dari jalur Revisi, tidak ada notifikasi otomatis ke PIC saat SPV menekan Terima. PIC mengetahui laporan disetujui saat membuka kembali Work Order." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;size=16;" parent="1" vertex="1">
                    <mxGeometry x="1980" y="790" width="320" height="150" as="geometry"/>
                </mxCell>
