@startuml PB1_Login
title Activity Diagram - Login (PDAM Surya Sembada Mobile)

skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF59D
skinparam ActivityDiamondBorderColor #F9A825
skinparam ArrowColor #455A64
skinparam DefaultFontName Arial

|User (SPV / Staff Senior / Staff)|
start
:Membuka aplikasi;

repeat
  :Mengisi email dan password;
  :Menekan tombol "Masuk";

  |Sistem|
  if (Email dan password terisi?) then (tidak)
    :Tampilkan pesan
    "Email/Password wajib diisi";
  else (ya)
    :Kirim data login ke Backend;

    |Backend|
    :Mencari akun berdasarkan email;
    if (Akun terdaftar, aktif, dan
    password sesuai?) then (tidak)
      :Kirim pesan kesalahan
      (email salah / password salah /
      akun nonaktif);

      |Sistem|
      :Tampilkan pesan kesalahan;
    else (ya)
      |Backend|
      :Buat token akses;
      :Kirim token dan data pengguna
      (role, departemen, jabatan);

      |Sistem|
      :Simpan sesi login di perangkat;
      :Periksa izin akses aplikasi
      (role, departemen, jabatan);

      note right
        Kombinasi role, departemen, dan jabatan
        yang diizinkan ditentukan oleh SuperAdmin
        saat akun pegawai dibuat.
      end note

      if (Sesuai izin akses SuperAdmin?) then (tidak)
        :Hapus sesi;
        :Tampilkan pesan
        "Tidak memiliki izin mengakses aplikasi";
      else (ya)
        :Arahkan ke halaman utama
        sesuai jabatan (SPV/Staff);
      endif
    endif
  endif

  |User (SPV / Staff Senior / Staff)|
repeat while (Proses login berhasil?) is (tidak)
->ya;
:Mengakses halaman utama dan
fitur sesuai perannya;
stop

@enduml
